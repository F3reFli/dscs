{
    "name": "dscs/docs",
    "description": "Documentation locale de DSCS (PHP + SCSS)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "scssphp/scssphp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Dscs\\Docs\\": "src/"
        }
    },
    "scripts": {
        "build-css": "php bin/build-css.php",
        "serve": "php -S localhost:8080 -t public public/router.php"
    },
    "config": {
        "sort-packages": true
    }
}
